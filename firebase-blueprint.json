        "equipeId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 64
        },
        "semanaId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 64
        },
        "payload": {
          "type": "object"
        },
        "versao": {
          "type": "integer"
        },
        "syncProtocolVersion": {
          "type": "integer"
        },
        "baselineEpoch": {
          "type": "integer"
        },
        "atualizadoEmMs": {
          "type": "number"
        },
        "atualizadoPorUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "atualizadoPorEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "equipeId",
        "semanaId",
        "payload",
        "versao",
        "syncProtocolVersion",
        "baselineEpoch",
        "atualizadoEmMs",
        "atualizadoPorUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "PmcdAndamentoDados": {
      "title": "PmcdAndamentoDados",
      "description": "Documento granular v2 por meta ou balde determinístico de boletins (Ciclo e LIRAa).",
      "type": "object",
      "properties": {
        "equipeId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 64
        },
        "andamentoId": {
          "type": "string",
          "enum": [
            "ciclo_meta",
            "ciclo_b0",
            "ciclo_b1",
            "ciclo_b2",
            "ciclo_b3",
            "liraa_meta",
            "liraa_b0",
            "liraa_b1",
            "liraa_b2",
            "liraa_b3"
          ],
          "maxLength": 64
        },
        "payload": {
          "type": "object"
        },
        "versao": {
          "type": "integer"
        },
        "syncProtocolVersion": {
          "type": "integer"
        },
        "baselineEpoch": {
          "type": "integer"
        },
        "atualizadoEmMs": {
          "type": "number"
        },
        "atualizadoPorUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "atualizadoPorEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "equipeId",
        "andamentoId",
        "payload",
        "versao",
        "syncProtocolVersion",
        "baselineEpoch",
        "atualizadoEmMs",
        "atualizadoPorUid",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/private/profile": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Dados privados do usuário autenticado (email, nome, papel)."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Lista confiável de administradores."
    },
    "/equipes/{equipeId}": {
      "schema": { "$ref": "#/entities/EquipeWorkspace" },
      "description": "Documento mestre do workspace da equipe PMCD."
    },
    "/equipes/{equipeId}/membros/{memberUid}": {
      "schema": { "$ref": "#/entities/EquipeMembro" },
      "description": "Membros ativos vinculados à equipe."
    },
    "/equipes/{equipeId}/convites/{conviteId}": {
      "schema": { "$ref": "#/entities/EquipeConvite" },
      "description": "Convites/autorizações de e-mail gerenciados pelo administrador."
    },
    "/equipes/{equipeId}/modulos/{moduloId}": {
      "schema": { "$ref": "#/entities/PmcdModuloDados" },
      "description": "Coleção legada preservada para compatibilidade e rollback."
    },
    "/equipes/{equipeId}/meta/{metaId}": {
      "schema": { "$ref": "#/entities/PmcdSyncMeta" },
      "description": "Metadados de controle de versão mínima, época oficial e migração v2."
    },
    "/equipes/{equipeId}/dominios/{dominioId}": {
      "schema": { "$ref": "#/entities/PmcdDominioDados" },
      "description": "Configuração geral, programações, índices/tabela LIRAa e relatórios/resumo com OCC."
    },
    "/equipes/{equipeId}/semanas/{semanaId}": {
      "schema": { "$ref": "#/entities/PmcdSemanaDados" },
      "description": "Lançamentos diários isolados por semana epidemiológica (Ciclo/LIRAa) com OCC e tombstones."
    },
    "/equipes/{equipeId}/andamentos/{andamentoId}": {
      "schema": { "$ref": "#/entities/PmcdAndamentoDados" },
      "description": "Andamento e boletins dos quarteirões particionados em buckets com OCC."
    }
  }
}
