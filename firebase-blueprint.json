        "equipeId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 64
        },
        "dominioId": {
          "type": "string",
          "enum": ["config_geral", "relatorios_e_resumo"],
          "maxLength": 64
        },
        "payload": {
          "type": "object"
        },
        "versao": {
          "type": "integer"
        },
        "syncProtocolVersion": {
          "type": "integer"
        },
        "baselineEpoch": {
          "type": "integer"
        },
        "atualizadoEmMs": {
          "type": "number"
        },
        "atualizadoPorUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "atualizadoPorEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "equipeId",
        "dominioId",
        "payload",
        "versao",
        "syncProtocolVersion",
        "baselineEpoch",
        "atualizadoEmMs",
        "atualizadoPorUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "PmcdSemanaDados": {
      "title": "PmcdSemanaDados",
      "description": "Documento granular v2 por semana epidemiológica (Ciclo ou LIRAa).",
